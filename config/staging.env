# Staging Environment Configuration
# For testing production-like settings

# Application Settings
APP_NAME=Financial AI Agents (Staging)
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["https://staging.yourdomain.com", "https://test.yourdomain.com"]

# AI Model Configuration
DEFAULT_MODEL=qwen/qwen3-32b
MAX_SOURCES=8
REQUEST_TIMEOUT=300

# API Keys (Set via environment variables)
# GROQ_API_KEY=
# PHI_API_KEY=

# Security Settings (Production-like but slightly relaxed)
RATE_LIMIT_PER_MINUTE=80
RATE_LIMIT_PER_HOUR=800
BURST_LIMIT=15
MAX_REQUEST_SIZE_MB=8
ENABLE_INPUT_SANITIZATION=true
ENABLE_IP_BLOCKING=false

# Staging Features
ENABLE_RELOAD=false
ENABLE_PROFILING=true

# Monitoring
LOG_FORMAT=structured
LOG_FILE=/app/logs/financial-ai-agents-staging.log