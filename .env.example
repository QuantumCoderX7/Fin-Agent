# API Keys (Required) - Replace with your actual keys
# Get Groq key from: https://console.groq.com/keys (FREE)
# Get OpenAI key from: https://platform.openai.com/api-keys (PAID)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
APP_NAME=Financial AI Agents
DEBUG=false
LOG_LEVEL=INFO

# API Settings
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*

# Agent Settings
DEFAULT_MODEL=qwen/qwen3-32b
MAX_SOURCES=10
REQUEST_TIMEOUT=300

# Server Settings
HOST=0.0.0.0
PORT=8000