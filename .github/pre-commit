#!/bin/sh
# Pre-commit hook to prevent security issues and enforce code quality
# Place this file in .git/hooks/pre-commit and make it executable

echo "🔍 Running pre-commit security and quality checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_error() {
    echo "${RED}❌ $1${NC}"
}

print_warning() {
    echo "${YELLOW}⚠️  $1${NC}"
}

print_success() {
    echo "${GREEN}✅ $1${NC}"
}

# Check for .env files
if git diff --cached --name-only | grep -E "^\.env$"; then
    print_error ".env file detected in commit!"
    echo "The .env file contains sensitive information and should not be committed."
    echo "Please remove it from the commit:"
    echo "  git reset HEAD .env"
    echo ""
    echo "If you need to update the template, modify .env.example instead."
    exit 1
fi

# Check for potential API keys and secrets
api_key_patterns="(gsk_[a-zA-Z0-9]{50,}|sk-proj-[a-zA-Z0-9]{20,}|sk-[a-zA-Z0-9]{48,})"
password_patterns="(password\s*=\s*['\"][^'\"]{8,}['\"]|secret\s*=\s*['\"][^'\"]{8,}['\"])"

# Check staged files for secrets
for file in $(git diff --cached --name-only); do
    if [ -f "$file" ]; then
        # Skip binary files
        if file "$file" | grep -q "binary"; then
            continue
        fi
        
        # Check for API keys
        if git show ":$file" | grep -qE "$api_key_patterns"; then
            print_error "Potential API key detected in $file"
            echo "Please remove API keys from the code and use environment variables instead."
            echo "Detected patterns that look like API keys:"
            git show ":$file" | grep -E "$api_key_patterns" | head -3
            exit 1
        fi
        
        # Check for hardcoded passwords
        if git show ":$file" | grep -qE "$password_patterns"; then
            print_warning "Potential hardcoded password detected in $file"
            echo "Please ensure no real passwords are hardcoded in the source."
        fi
        
        # Check for TODO/FIXME comments in production files
        if echo "$file" | grep -qE "\.(py|js|ts|jsx|tsx)$"; then
            todo_count=$(git show ":$file" | grep -cE "(TODO|FIXME|XXX|HACK)" || true)
            if [ "$todo_count" -gt 0 ]; then
                print_warning "$todo_count TODO/FIXME comments found in $file"
                echo "Consider addressing these before committing to main branch."
            fi
        fi
    fi
done

# Check for large files (>10MB)
large_files=$(git diff --cached --name-only | xargs -I {} find {} -size +10M 2>/dev/null || true)
if [ -n "$large_files" ]; then
    print_error "Large files detected (>10MB):"
    echo "$large_files"
    echo ""
    echo "Large files should not be committed to git. Consider:"
    echo "  - Using Git LFS for large assets"
    echo "  - Storing files externally (cloud storage)"
    echo "  - Adding to .gitignore if they're build artifacts"
    exit 1
fi

# Check Python code quality (if Python files are being committed)
python_files=$(git diff --cached --name-only | grep "\.py$" || true)
if [ -n "$python_files" ]; then
    # Check if Python tools are available
    if command -v python3 >/dev/null 2>&1; then
        # Check for syntax errors
        for file in $python_files; do
            if ! python3 -m py_compile "$file" 2>/dev/null; then
                print_error "Python syntax error in $file"
                python3 -m py_compile "$file"
                exit 1
            fi
        done
        print_success "Python syntax check passed"
        
        # Run basic security check if bandit is available
        if command -v bandit >/dev/null 2>&1; then
            if ! bandit -r $python_files -f txt >/dev/null 2>&1; then
                print_warning "Bandit security scan found potential issues"
                echo "Run 'bandit -r $python_files' to see details"
            else
                print_success "Bandit security scan passed"
            fi
        fi
    fi
fi

# Check JavaScript/TypeScript code (if available)
js_files=$(git diff --cached --name-only | grep -E "\.(js|jsx|ts|tsx)$" || true)
if [ -n "$js_files" ]; then
    if command -v node >/dev/null 2>&1; then
        # Check for syntax errors in JS files
        for file in $js_files; do
            if echo "$file" | grep -q "\.js$"; then
                if ! node -c "$file" 2>/dev/null; then
                    print_error "JavaScript syntax error in $file"
                    node -c "$file"
                    exit 1
                fi
            fi
        done
        print_success "JavaScript syntax check passed"
    fi
fi

# Check for merge conflict markers
conflict_files=$(git diff --cached --name-only | xargs grep -l "^<<<<<<< \|^======= \|^>>>>>>> " 2>/dev/null || true)
if [ -n "$conflict_files" ]; then
    print_error "Merge conflict markers detected in:"
    echo "$conflict_files"
    echo ""
    echo "Please resolve all merge conflicts before committing."
    exit 1
fi

# Check for debugging statements
debug_patterns="(console\.log|debugger|pdb\.set_trace|import pdb|print\(.*debug|var_dump)"
debug_files=$(git diff --cached --name-only | xargs grep -l "$debug_patterns" 2>/dev/null || true)
if [ -n "$debug_files" ]; then
    print_warning "Debugging statements detected in:"
    echo "$debug_files"
    echo ""
    echo "Consider removing debugging statements before committing."
    echo "If intentional, you can proceed with the commit."
fi

# Check commit message format (basic check)
if [ -f ".git/COMMIT_EDITMSG" ]; then
    commit_msg=$(head -n1 .git/COMMIT_EDITMSG)
    if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|test|chore|security|perf|ci)(\(.+\))?: .+"; then
        print_warning "Commit message doesn't follow conventional format"
        echo "Expected format: type(scope): description"
        echo "Current: $commit_msg"
    fi
fi

# Final success message
print_success "Pre-commit checks completed successfully!"
echo ""
echo "📋 Summary:"
echo "  - No .env files detected"
echo "  - No API keys found in staged files"
echo "  - No large files (>10MB) detected"
echo "  - No merge conflict markers found"
if [ -n "$python_files" ]; then
    echo "  - Python syntax validated"
fi
if [ -n "$js_files" ]; then
    echo "  - JavaScript syntax validated"
fi

exit 0